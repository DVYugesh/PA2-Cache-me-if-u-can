#include "cache.h"
#include <array>
#include <unordered_map>
#include <algorithm>

#define IP_TRACKER_COUNT 24
#define MASK_IP 0xFF

#define UNIFORM_THRESHOLD 4
#define NON_UNIFORM_THRESHOLD 2
#define MAX_COUNTER 15

#define PREDICTION_THRESHOLD 0.25


#define MAX_DELTAS 4


struct delta_entry {
    int64_t delta=0;
    int counter=0;
    bool valid=false;
};

struct pattern_entry{
    std::array<delta_entry,MAX_DELTAS> deltas;
    int total;
};

class pattern_table{
    std::unordered_map<uint32_t,pattern_entry> table;
public:
    void update(uint32_t signature, int64_t stride){
        pattern_entry &entry = table[signature];
        delta_entry* target = nullptr;

        for(auto &d : entry.deltas){
            if(d.valid && d.delta == stride){
                target = &d;
                break;
            }
        }

        if(target == nullptr) {
            for (auto &d : entry.deltas) {
                if (!d.valid) {
                    target = &d;
                    break;
                }
            }
        }

        if(target == nullptr) {
            target = &*std::min_element(
                entry.deltas.begin(),
                entry.deltas.end(),
                [](const delta_entry &a, const delta_entry &b) {
                    return a.counter < b.counter;
                }
            );
        }

        if(!target->valid || target->delta != stride) {
            target->delta = stride;
            target->counter = 0;
            target->valid = true;
        }

        entry.total++;
        target->counter++;
    }

    bool predict(uint16_t signature,int64_t &predicted_delta,double threshold = 0.25) {
        auto it = table.find(signature);

        if (it == table.end())
            return false;

        const auto &entry = it->second;

        if (entry.total == 0)
            return false;

        const delta_entry* best = nullptr;

        for (const auto &d : entry.deltas) {
            if (!d.valid)
                continue;

            if (best == nullptr ||
                d.counter > best->counter) {
                best = &d;
            }
        }

        if (best == nullptr)
            return false;

        double confidence =static_cast<double>(best->counter) /entry.total;

        if (confidence < threshold)
            return false;

        predicted_delta = best->delta;

        return true;
    }
};

class IP_TRACKER{

public:
    uint64_t ip;

    // use LRU to evict old IP trackers
    uint32_t lru;
    bool non_uniform_mode;

    uint64_t last_cl_addr;
    int64_t last_stride;

    uint32_t signature;
    uint8_t uniform_confidence;
    uint8_t break_confidence;

    pattern_table table;

    IP_TRACKER(): ip(0),lru(0),non_uniform_mode(0),last_cl_addr(0),last_stride(0),signature(0),uniform_confidence(0)
    ,break_confidence(0) {}

    void update_signature(int64_t delta){
        uint64_t magnitude =
            static_cast<uint64_t>(
                delta < 0 ? -delta : delta
            );

        // 7-bit sign + magnitude representation
        magnitude = std::min<uint64_t>(magnitude, 63);

        uint16_t encoded_delta =
            static_cast<uint16_t>(magnitude);

        if (delta < 0)
            encoded_delta |= (1 << 6);

        signature =
            static_cast<uint16_t>(
                ((signature << 3) ^
                 encoded_delta) & 0xFFF
            );
    }

    void update_mode(int64_t delta){
        if (uniform_confidence == 0 &&
            break_confidence == 0 &&
            last_stride == 0) {

            uniform_confidence = 1;
            return;
        }

        if (delta == last_stride) {

            if (uniform_confidence < MAX_COUNTER)
                uniform_confidence++;

            if (break_confidence > 0)
                break_confidence--;

            // Stable uniform pattern detected again
            if (non_uniform_mode &&
                uniform_confidence >= UNIFORM_THRESHOLD) {

                non_uniform_mode = false;
                break_confidence = 0;
            }
        }
        else {

            if (break_confidence < MAX_COUNTER)
                break_confidence++;

            if (uniform_confidence > 0)
                uniform_confidence--;

            // Require multiple mismatches before switching
            if (!non_uniform_mode &&
                break_confidence >=
                    NON_UNIFORM_THRESHOLD) {

                non_uniform_mode = true;
                uniform_confidence = 0;
            }
        }
    }

    void update_pattern(uint32_t sig, int64_t delta){
        table.update(sig,delta);
    }

    void update(uint64_t current_cl_address){
        if(last_cl_addr==0) {
            last_cl_addr = current_cl_address;
            return;
        }

        int64_t delta=static_cast<int64_t>(current_cl_address)-static_cast<int64_t>(last_cl_addr);

        if (delta == 0) return;

        update_pattern(signature, delta);
        update_mode(delta);

        update_signature(delta);
        last_stride = delta;
        last_cl_addr = current_cl_address;
    }

    int predict(uint64_t predicted_addr[], int degree){
        int64_t predicted_stride;

        uint64_t current_addr = last_cl_addr;
        uint16_t current_signature = signature;

        int count = 0;

        for (int d = 0; d < degree; d++){

            if (!non_uniform_mode) {
                predicted_stride = last_stride;

                if (predicted_stride == 0)
                    break;
            }

            else{
                auto prediction = table.predict(signature,predicted_stride);

                if (!prediction)
                    break;
            }

            uint64_t next_addr;

            if (predicted_stride >= 0) {
                next_addr = last_cl_addr +
                    static_cast<uint64_t>(
                        predicted_stride
                    );
            } 
            else {
                next_addr = last_cl_addr -
                    static_cast<uint64_t>(
                        -predicted_stride
                    );
            }
            predicted_addr[count] = next_addr;
            count++;

            current_addr = next_addr;

            uint64_t magnitude =
            static_cast<uint64_t>(
                predicted_stride < 0
                    ? -predicted_stride
                    : predicted_stride
            );

            magnitude = std::min<uint64_t>(magnitude, 63);

            uint16_t encoded_delta =
                static_cast<uint16_t>(magnitude);

            if (predicted_stride < 0)
                encoded_delta |= (1 << 6);

            current_signature =
                static_cast<uint16_t>(
                    ((current_signature << 3) ^
                    encoded_delta) & 0xFFF
                );
        }
        return count;
    }
};

IP_TRACKER trackers[IP_TRACKER_COUNT];

void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    for (int i=0; i<IP_TRACKER_COUNT; i++) trackers[i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    // check for a tracker hit
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    ip = ip & MASK_IP;

    int index = -1;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }

    // this is a new IP that doesn't have a tracker yet, so allocate one
    if (index == IP_TRACKER_COUNT) {

        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        trackers[index].ip = ip;
        
        for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;

        return;

    }

    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;

    trackers[index].update(cl_addr);

    uint64_t predictions[3];

    int count = trackers[index].predict(predictions, 3);
    for (int i = 0; i < count; i++) {

        if(predictions[i] == cl_addr) continue;

        uint64_t pf_addr =predictions[i] << LOG2_BLOCK_SIZE;

        if ((pf_addr >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE)) continue;

        if (MSHR.occupancy < (MSHR.SIZE>>1))
            prefetch_line(ip, addr, pf_addr, FILL_L1, 0);
        else
            prefetch_line(ip, addr, pf_addr, FILL_L2, 0);
    }
    
    return; 
}

